{
  "manifest_version": 3,
  "name": "Annotator",
  "short_name": "Annotator",
  "version": "0.0.1",
  "description": "Click the toolbar icon on any page → drag a rectangle → leave a note. Lands in your local annotator queue.",
  "author": "Vylth Labs",
  "homepage_url": "https://github.com/VYLTH/annotator",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_title": "Annotate this page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],

  "web_accessible_resources": [
    {
      "resources": ["overlay.css", "icon.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
